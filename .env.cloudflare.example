# Production secrets for the Cloudflare Worker.
# cp .env.cloudflare.example .env.cloudflare  →  fill in  →  npm run cf:secrets
# (.env.cloudflare is git-ignored; values are uploaded as encrypted Worker secrets.)

DB_URL=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<database>
NEXTAUTH_SECRET=<openssl rand -base64 32>
NEXTAUTH_URL=https://<your-domain-or-radhamadhob.<account>.workers.dev>
# Optional
# NEXT_PUBLIC_SITE_URL=https://<your-domain>
# MONGODB_DB_NAME=radhamadhab
