# ---------------------------------------------------------------------------
# Radhamadhob CMS — Next.js full-stack environment
# Copy to `.env.local` for development. On Cloudflare set these as Worker
# secrets/vars (see DEPLOYMENT.md). Never commit real values.
# ---------------------------------------------------------------------------

# MongoDB connection string (database name is taken from the path).
DB_URL="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<database>"
# Optional: override the database name from DB_URL.
# MONGODB_DB_NAME="radhamadhab"

# Public site URL (canonical URLs, NextAuth callbacks). Must be https in production.
NEXTAUTH_URL="http://localhost:3000"
# NEXT_PUBLIC_SITE_URL="https://www.example.org"

# Signs/encrypts the session cookie and derives the access-token key.
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="<random-32-byte-secret>"

# There is no registration. Create/reset admin passwords server-side:
#   npm run admin:password -- <email> <password> [--create "Display Name" [role]]
