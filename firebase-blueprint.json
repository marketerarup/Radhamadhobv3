{
  "entities": {
    "User": {
      "title": "User",
      "description": "Authenticated admin user record in the users collection",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Firebase Auth UID",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "Admin email address",
          "minLength": 3,
          "maxLength": 254
        },
        "displayName": {
          "type": "string",
          "description": "Admin full name",
          "minLength": 1,
          "maxLength": 120
        },
        "role": {
          "type": "string",
          "description": "Admin role assignment",
          "enum": ["admin", "editor"]
        },
        "createdAt": {
          "type": "string",
          "description": "ISO timestamp of creation",
          "maxLength": 64
        }
      },
      "required": ["uid", "email", "displayName", "role", "createdAt"]
    },
    "WebsiteSettings": {
      "title": "WebsiteSettings",
      "description": "Global website configuration in the settings collection",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Settings document ID",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "logo": {
          "type": "string",
          "description": "Uploaded organization logo URL or Storage reference",
          "maxLength": 500000
        },
        "organization_name": {
          "type": "string",
          "description": "Organization name in Bengali",
          "minLength": 1,
          "maxLength": 200
        },
        "organization_name_en": {
          "type": "string",
          "description": "Organization name in English",
          "maxLength": 200
        },
        "about": {
          "type": "string",
          "description": "About Us text controlled from dashboard",
          "minLength": 1,
          "maxLength": 5000
        },
        "about_secondary": {
          "type": "string",
          "description": "Second paragraph of About Us text",
          "maxLength": 5000
        },
        "mission_text": {
          "type": "string",
          "description": "Mission statement controlled from dashboard",
          "maxLength": 2000
        },
        "vision_text": {
          "type": "string",
          "description": "Vision statement controlled from dashboard",
          "maxLength": 2000
        },
        "hero_title": {
          "type": "string",
          "description": "Homepage Hero Title",
          "maxLength": 300
        },
        "hero_subtitle": {
          "type": "string",
          "description": "Homepage Hero Subtitle",
          "maxLength": 600
        },
        "phone": {
          "type": "string",
          "description": "Official contact phone number",
          "minLength": 3,
          "maxLength": 60
        },
        "whatsapp": {
          "type": "string",
          "description": "Official WhatsApp contact number",
          "minLength": 3,
          "maxLength": 60
        },
        "whatsapp_prefill_message": {
          "type": "string",
          "description": "Pre-filled message for WhatsApp joining",
          "maxLength": 500
        },
        "facebook": {
          "type": "string",
          "description": "Official Facebook page URL",
          "maxLength": 500
        },
        "youtube": {
          "type": "string",
          "description": "Official YouTube channel URL",
          "maxLength": 500
        },
        "footer_text": {
          "type": "string",
          "description": "Footer short description",
          "maxLength": 2000
        },
        "copyright_text": {
          "type": "string",
          "description": "Copyright notice in footer",
          "maxLength": 300
        },
        "updated_date": {
          "type": "string",
          "description": "Last updated date",
          "maxLength": 64
        }
      },
      "required": [
        "id",
        "logo",
        "organization_name",
        "about",
        "phone",
        "whatsapp",
        "facebook",
        "footer_text",
        "copyright_text"
      ]
    },
    "Member": {
      "title": "Member",
      "description": "Organization member record in the members collection",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Member document ID",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "name": {
          "type": "string",
          "description": "Full Name of member",
          "minLength": 1,
          "maxLength": 200
        },
        "photo": {
          "type": "string",
          "description": "Original uploaded member photo URL",
          "minLength": 1,
          "maxLength": 700000
        },
        "position": {
          "type": "string",
          "description": "Member position in organization",
          "minLength": 1,
          "maxLength": 200
        },
        "father_name": {
          "type": "string",
          "description": "Father Name",
          "maxLength": 200
        },
        "mother_name": {
          "type": "string",
          "description": "Mother Name",
          "maxLength": 200
        },
        "address": {
          "type": "string",
          "description": "Member residential address",
          "maxLength": 500
        },
        "phone": {
          "type": "string",
          "description": "Member mobile number",
          "maxLength": 60
        },
        "email": {
          "type": "string",
          "description": "Member email address",
          "maxLength": 254
        },
        "biography": {
          "type": "string",
          "description": "Member biography",
          "maxLength": 3000
        },
        "joining_date": {
          "type": "string",
          "description": "Joining date in organization",
          "maxLength": 64
        }
      },
      "required": [
        "id",
        "name",
        "photo",
        "position",
        "father_name",
        "mother_name",
        "address",
        "phone",
        "email",
        "biography",
        "joining_date"
      ]
    },
    "Drama": {
      "title": "Drama",
      "description": "Stage drama production in the dramas collection",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Drama document ID",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "title": {
          "type": "string",
          "description": "Drama name",
          "minLength": 1,
          "maxLength": 300
        },
        "category": {
          "type": "string",
          "description": "Drama category",
          "minLength": 1,
          "maxLength": 120
        },
        "poster": {
          "type": "string",
          "description": "Original drama poster/stage image",
          "minLength": 1,
          "maxLength": 700000
        },
        "description": {
          "type": "string",
          "description": "Full drama description",
          "minLength": 1,
          "maxLength": 5000
        },
        "year": {
          "type": "string",
          "description": "Performance year",
          "maxLength": 32
        },
        "director": {
          "type": "string",
          "description": "Director name",
          "maxLength": 200
        },
        "cast": {
          "type": "array",
          "description": "Cast members list"
        },
        "gallery": {
          "type": "array",
          "description": "Drama stage gallery images"
        },
        "youtube_link": {
          "type": "string",
          "description": "YouTube video link for the drama",
          "maxLength": 500
        },
        "created_date": {
          "type": "string",
          "description": "Created date",
          "maxLength": 64
        }
      },
      "required": [
        "id",
        "title",
        "category",
        "poster",
        "description",
        "year",
        "director",
        "cast",
        "gallery",
        "youtube_link"
      ]
    },
    "CulturalProgram": {
      "title": "CulturalProgram",
      "description": "Cultural program activity in the programs collection",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Program document ID",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "title": {
          "type": "string",
          "description": "Program title",
          "minLength": 1,
          "maxLength": 300
        },
        "image": {
          "type": "string",
          "description": "Original program stage image",
          "minLength": 1,
          "maxLength": 700000
        },
        "description": {
          "type": "string",
          "description": "Program description",
          "minLength": 1,
          "maxLength": 4000
        },
        "date": {
          "type": "string",
          "description": "Program date or schedule",
          "maxLength": 100
        },
        "category": {
          "type": "string",
          "description": "Program category (Religious, Dance, Cultural, Music)",
          "maxLength": 120
        }
      },
      "required": ["id", "title", "image", "description", "date", "category"]
    },
    "CulturalEvent": {
      "title": "CulturalEvent",
      "description": "Previous or upcoming cultural event in the events collection",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Event document ID",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "event_name": {
          "type": "string",
          "description": "Event name",
          "minLength": 1,
          "maxLength": 300
        },
        "date": {
          "type": "string",
          "description": "Event date",
          "maxLength": 100
        },
        "location": {
          "type": "string",
          "description": "Event venue/location",
          "maxLength": 300
        },
        "description": {
          "type": "string",
          "description": "Event description",
          "maxLength": 5000
        },
        "cover_image": {
          "type": "string",
          "description": "Original event cover photo",
          "maxLength": 700000
        },
        "gallery_images": {
          "type": "array",
          "description": "Event gallery photos"
        }
      },
      "required": [
        "id",
        "event_name",
        "date",
        "location",
        "description",
        "cover_image",
        "gallery_images"
      ]
    },
    "GalleryItem": {
      "title": "GalleryItem",
      "description": "Original cultural photograph in the gallery collection",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Gallery item ID",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "image": {
          "type": "string",
          "description": "Uploaded original image URL",
          "minLength": 1,
          "maxLength": 700000
        },
        "title": {
          "type": "string",
          "description": "Photo title",
          "minLength": 1,
          "maxLength": 300
        },
        "category": {
          "type": "string",
          "description": "Category (Drama, Dance, Religious, Cultural Program)",
          "minLength": 1,
          "maxLength": 120
        },
        "description": {
          "type": "string",
          "description": "Photo description",
          "maxLength": 2000
        },
        "date": {
          "type": "string",
          "description": "Photo date",
          "maxLength": 64
        }
      },
      "required": ["id", "image", "title", "category", "description", "date"]
    },
    "YouTubeVideo": {
      "title": "YouTubeVideo",
      "description": "YouTube video item in the videos collection",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Video document ID",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "youtube_link": {
          "type": "string",
          "description": "Video URL",
          "minLength": 1,
          "maxLength": 500
        },
        "title": {
          "type": "string",
          "description": "Video title",
          "minLength": 1,
          "maxLength": 300
        },
        "description": {
          "type": "string",
          "description": "Video description",
          "maxLength": 3000
        },
        "thumbnail": {
          "type": "string",
          "description": "Original thumbnail image",
          "maxLength": 700000
        },
        "created_date": {
          "type": "string",
          "description": "Date added",
          "maxLength": 64
        }
      },
      "required": ["id", "youtube_link", "title", "description", "thumbnail"]
    },
    "SeoPageConfig": {
      "title": "SeoPageConfig",
      "description": "Page SEO metadata record in the seo collection",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Page SEO ID (home, about, drama, programs, gallery, contact, privacy_policy)",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "page_name": {
          "type": "string",
          "description": "Display name of the page",
          "minLength": 1,
          "maxLength": 120
        },
        "seo_title": {
          "type": "string",
          "description": "SEO Title tag",
          "minLength": 1,
          "maxLength": 160
        },
        "meta_description": {
          "type": "string",
          "description": "Meta description content",
          "minLength": 1,
          "maxLength": 320
        },
        "keywords": {
          "type": "string",
          "description": "Comma-separated SEO keywords",
          "maxLength": 500
        },
        "url_slug": {
          "type": "string",
          "description": "Canonical URL slug",
          "maxLength": 200
        },
        "og_image": {
          "type": "string",
          "description": "OpenGraph social share image",
          "maxLength": 700000
        },
        "schema_data": {
          "type": "string",
          "description": "JSON-LD Schema.org structured data",
          "maxLength": 10000
        }
      },
      "required": [
        "id",
        "page_name",
        "seo_title",
        "meta_description",
        "keywords",
        "url_slug",
        "og_image",
        "schema_data"
      ]
    },
    "PrivacyPolicyDoc": {
      "title": "PrivacyPolicyDoc",
      "description": "Bilingual Privacy Policy record in the privacy_policy collection",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Privacy policy document ID",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "bengali_policy": {
          "type": "string",
          "description": "Complete Bengali Privacy Policy overview text",
          "minLength": 1,
          "maxLength": 20000
        },
        "english_policy": {
          "type": "string",
          "description": "Complete English Privacy Policy overview text",
          "minLength": 1,
          "maxLength": 20000
        },
        "updated_date": {
          "type": "string",
          "description": "Last updated date",
          "maxLength": 64
        }
      },
      "required": ["id", "bengali_policy", "english_policy", "updated_date"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "Admin users collection for role-based dashboard access"
    },
    "/settings/{settingId}": {
      "schema": "WebsiteSettings",
      "description": "Global website settings collection (logo, organization_name, about, phone, whatsapp, facebook, footer_text)"
    },
    "/members/{memberId}": {
      "schema": "Member",
      "description": "Organization members collection with full profile and original photo"
    },
    "/dramas/{dramaId}": {
      "schema": "Drama",
      "description": "Theatrical dramas collection"
    },
    "/programs/{programId}": {
      "schema": "CulturalProgram",
      "description": "Cultural programs collection (Religious, Dance, Cultural, Music)"
    },
    "/events/{eventId}": {
      "schema": "CulturalEvent",
      "description": "Previous and upcoming cultural events collection"
    },
    "/gallery/{galleryId}": {
      "schema": "GalleryItem",
      "description": "Masonry cultural photo gallery collection"
    },
    "/videos/{videoId}": {
      "schema": "YouTubeVideo",
      "description": "YouTube video showcase collection"
    },
    "/seo/{seoId}": {
      "schema": "SeoPageConfig",
      "description": "Page-level SEO metadata and Schema.org structured data collection"
    },
    "/privacy_policy/{policyId}": {
      "schema": "PrivacyPolicyDoc",
      "description": "Bilingual Bengali and English Privacy Policy collection"
    }
  }
}
