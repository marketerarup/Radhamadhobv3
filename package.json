{
  "name": "radhamadhob-cms",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "next dev --port=3000",
    "build": "next build",
    "start": "next start --port=3000",
    "lint": "tsc --noEmit",
    "clean": "rm -rf .next .open-next",
    "db:seed": "tsx --env-file-if-exists=.env.local scripts/seed-cms.ts",
    "admin:password": "tsx --env-file-if-exists=.env.local scripts/set-admin-password.ts",
    "cf:build": "opennextjs-cloudflare build && node scripts/cf-strip-env.mjs",
    "cf:preview": "npm run cf:build && opennextjs-cloudflare preview",
    "cf:deploy": "npm run cf:build && opennextjs-cloudflare deploy",
    "cf:upload": "npm run cf:build && opennextjs-cloudflare upload",
    "cf:secrets": "wrangler secret bulk .env.cloudflare",
    "cf:typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "aws4fetch": "^1.0.20",
    "jose": "^6.2.12",
    "lucide-react": "^0.546.0",
    "mongodb": "^6.21.0",
    "motion": "^12.23.24",
    "next": "16.3.8",
    "next-auth": "4.24.15",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.10",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "wrangler": "^4.149.0"
  }
}
