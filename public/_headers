# Cloudflare Workers static-asset headers (served before the Worker runs)

# Next.js build output is content-hashed: cache forever
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# Stage photography (stable file names)
/assets/images/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400
